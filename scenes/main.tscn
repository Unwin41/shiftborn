[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/arena_grid.gd" id="2_grid"]
[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="3_player"]
[ext_resource type="Script" path="res://addons/horde_kit/horde_spawner.gd" id="4_spawner"]
[ext_resource type="Script" path="res://addons/horde_kit/spawn_wave.gd" id="5_wave"]
[ext_resource type="PackedScene" path="res://scenes/enemy.tscn" id="6_enemy"]
[ext_resource type="PackedScene" path="res://scenes/enemy_runner.tscn" id="7_runner"]
[ext_resource type="PackedScene" path="res://scenes/enemy_skeleton.tscn" id="8_skeleton"]
[ext_resource type="Script" path="res://scripts/damage_numbers.gd" id="9_numbers"]
[ext_resource type="Script" path="res://scripts/xp_bar.gd" id="10_xp_bar"]
[ext_resource type="Script" path="res://scripts/energy_bars.gd" id="11_energy"]

[sub_resource type="Resource" id="Resource_opening"]
script = ExtResource("5_wave")
enemy_scene = ExtResource("6_enemy")
start_time = 0.0
end_time = 120.0
interval = 1.5
batch_size = 2

[sub_resource type="Resource" id="Resource_runners"]
script = ExtResource("5_wave")
enemy_scene = ExtResource("7_runner")
start_time = 45.0
end_time = 600.0
interval = 2.0
batch_size = 3

[sub_resource type="Resource" id="Resource_swarm"]
script = ExtResource("5_wave")
enemy_scene = ExtResource("8_skeleton")
start_time = 120.0
end_time = 600.0
interval = 0.8
batch_size = 4

[sub_resource type="Environment" id="Environment_glow"]
background_mode = 3
glow_levels/1 = 1.0
glow_levels/2 = 1.0
glow_levels/3 = 0.6
glow_levels/5 = 0.0
glow_intensity = 1.2
glow_strength = 1.0
glow_bloom = 0.0
glow_blend_mode = 0
glow_hdr_threshold = 1.2

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="Darkness" type="CanvasModulate" parent="."]
color = Color(0.58, 0.56, 0.68, 1)

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_glow")

[node name="Grid" type="Node2D" parent="."]
script = ExtResource("2_grid")

[node name="Enemies" type="Node2D" parent="."]

[node name="Player" parent="." instance=ExtResource("3_player")]

[node name="DamageNumbers" type="Node2D" parent="."]
script = ExtResource("9_numbers")

[node name="HordeSpawner" type="Node2D" parent="."]
script = ExtResource("4_spawner")
waves = Array[ExtResource("5_wave")]([SubResource("Resource_opening"), SubResource("Resource_runners"), SubResource("Resource_swarm")])
target_path = NodePath("../Player")
spawn_parent_path = NodePath("../Enemies")
spawn_radius = 380.0

[node name="HUD" type="CanvasLayer" parent="."]

[node name="XpBar" type="Control" parent="HUD"]
unique_name_in_owner = true
anchors_preset = 10
anchor_right = 1.0
offset_left = 4.0
offset_top = 4.0
offset_right = -4.0
offset_bottom = 14.0
grow_horizontal = 2
mouse_filter = 2
script = ExtResource("10_xp_bar")

[node name="StatusLabel" type="Label" parent="HUD"]
unique_name_in_owner = true
offset_left = 8.0
offset_top = 16.0
offset_right = 632.0
offset_bottom = 36.0
theme_override_font_sizes/font_size = 12

[node name="EnergyBars" type="Control" parent="HUD"]
unique_name_in_owner = true
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -32.0
offset_bottom = -6.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
script = ExtResource("11_energy")

[node name="CenterLabel" type="Label" parent="HUD"]
unique_name_in_owner = true
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1
vertical_alignment = 1
