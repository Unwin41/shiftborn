[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/arena_grid.gd" id="2_grid"]
[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="3_player"]
[ext_resource type="Script" path="res://addons/horde_kit/horde_spawner.gd" id="4_spawner"]
[ext_resource type="Script" path="res://addons/horde_kit/spawn_wave.gd" id="5_wave"]
[ext_resource type="PackedScene" path="res://scenes/enemy.tscn" id="6_enemy"]
[ext_resource type="PackedScene" path="res://scenes/enemy_runner.tscn" id="7_runner"]

[sub_resource type="Resource" id="Resource_opening"]
script = ExtResource("5_wave")
enemy_scene = ExtResource("6_enemy")
start_time = 0.0
end_time = 120.0
interval = 1.5
batch_size = 2

[sub_resource type="Resource" id="Resource_runners"]
script = ExtResource("5_wave")
enemy_scene = ExtResource("7_runner")
start_time = 45.0
end_time = 600.0
interval = 2.0
batch_size = 3

[sub_resource type="Resource" id="Resource_swarm"]
script = ExtResource("5_wave")
enemy_scene = ExtResource("6_enemy")
start_time = 120.0
end_time = 600.0
interval = 0.8
batch_size = 4

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="Grid" type="Node2D" parent="."]
script = ExtResource("2_grid")

[node name="Enemies" type="Node2D" parent="."]

[node name="Player" parent="." instance=ExtResource("3_player")]

[node name="HordeSpawner" type="Node2D" parent="."]
script = ExtResource("4_spawner")
waves = Array[ExtResource("5_wave")]([SubResource("Resource_opening"), SubResource("Resource_runners"), SubResource("Resource_swarm")])
target_path = NodePath("../Player")
spawn_parent_path = NodePath("../Enemies")
spawn_radius = 380.0

[node name="HUD" type="CanvasLayer" parent="."]

[node name="StatusLabel" type="Label" parent="HUD"]
unique_name_in_owner = true
offset_left = 8.0
offset_top = 6.0
offset_right = 632.0
offset_bottom = 26.0
theme_override_font_sizes/font_size = 12

[node name="CenterLabel" type="Label" parent="HUD"]
unique_name_in_owner = true
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1
vertical_alignment = 1
